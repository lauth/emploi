{
  "name": "@emploi/design-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "lint": "eslint .",
