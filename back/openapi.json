        ]
      },
      "get": {
        "description": "Most recent application first by default. Filters combine with AND; offers without a value for the sort field come last.",
        "operationId": "OffersController_list",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of offers per page.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "Number of offers to skip.",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "integer"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Text contained in the title, company or location, ignoring case. Blank is ignored.",
            "schema": {
              "maxLength": 200,
              "example": "backend",
              "type": "string"
            }
          },
          {
            "name": "appliedFrom",
            "required": false,
            "in": "query",
            "description": "Only offers applied on or after this day, `YYYY-MM-DD`.",
            "schema": {
              "format": "date",
              "example": "2026-09-01",
              "type": "string"
            }
          },
          {
            "name": "appliedTo",
            "required": false,
            "in": "query",
            "description": "Only offers applied on or before this day, `YYYY-MM-DD`. Not before `appliedFrom`.",
            "schema": {
              "format": "date",
              "example": "2026-09-30",
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Only offers with one of these statuses; repeat the parameter for several (`?status=applied&status=interviewing`). All when absent.",
            "schema": {
              "example": [
                "applied",
                "interviewing"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "applied",
                  "interviewing",
                  "offered",
                  "accepted",
                  "rejected",
                  "ghosted",
                  "withdrawn"
                ]
              }
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Sort field. Offers with no value for it (no application date, no company) come last. Statuses sort in the order of a search, `applied` first.",
            "schema": {
              "$ref": "#/components/schemas/OfferSortField"
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "description": "Sort direction. Default: `desc` for dates (most recent first), `asc` for text.",
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request: malformed id, body or query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 400,
                  "message": [
                    "title should not be empty"
                  ],
                  "error": "Bad Request"
                }
              }
            }
          }
        },
        "summary": "List offers: filtered, sorted and paginated",
        "tags": [
          "offers"
        ]
      }
    },
