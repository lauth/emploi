// Data model of emploi, single source of truth for the database (adrs/0003-postgresql-with-prisma.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A job offer the user responded to (adrs/0011-offer-data-model-and-api.md).
model Offer {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String    @db.VarChar(200)
  /// Optional: many offers don't name the employer (adrs/0014-offer-company-optional.md).
  company     String?   @db.VarChar(200)
  url         String?   @db.VarChar(2048)
  location    String?   @db.VarChar(200)
  description String?
  /// Day the user responded to the offer (no time part).
  appliedAt   DateTime? @map("applied_at") @db.Date
  status      OfferStatus @default(applied)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  interviewSteps InterviewStep[]

  // `title` and `company` use the ICU collation "und-x-icu" so text sorts
  // properly (accents, case). Prisma can't express collations: it is set in the
  // migration 20261006180726_offer_list_sorting (adrs/0020-offer-list-filters-sorting-and-pagination.md).

  /// Default order of the list: most recent application first.
  @@index([appliedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("offers")
}

/// Where the application for an offer stands, chosen by the user
/// (adrs/0022-offer-status.md). Declared in the order of a search: PostgreSQL
/// sorts enum values in this order.
enum OfferStatus {
  /// Sent, no answer yet.
  applied
  /// Interviews under way.
  interviewing
  /// The company made an offer.
  offered
  /// The user accepted the offer.
  accepted
  /// The company said no.
  rejected
  /// No answer after a long time.
  ghosted
  /// The user withdrew.
  withdrawn

  @@map("offer_status")
}

/// Where an interview step stands (adrs/0015-interview-step-data-model-and-api.md).
enum InterviewStepStatus {
  /// To come (scheduled or not yet).
  planned
  /// Done, waiting for the answer.
  pending
  /// Successful, the process goes on.
  passed
  /// Rejected at this step.
  failed
  /// Didn't take place.
  cancelled

  @@map("interview_step_status")
}

/// A step of the interview process of an offer (adrs/0004-flexible-interview-process-model.md).
model InterviewStep {
  id          String              @id @default(uuid(7)) @db.Uuid
  offerId     String              @map("offer_id") @db.Uuid
  offer       Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /// Order within the offer; may have gaps, only the order matters.
  position    Int
  title       String              @db.VarChar(200)
  description String?
  /// Day of the step (no time part); unknown until scheduled.
  date        DateTime?           @db.Date
  status      InterviewStepStatus @default(planned)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([offerId, position])
  @@map("interview_steps")
}
