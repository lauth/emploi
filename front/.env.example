# Copy to front/.env.local to run the front on the host (`pnpm --filter front dev`).
# Base URL of the API, read at runtime by server code (adrs/0012-front-calls-api-from-server.md).
API_URL=https://api.emploi.localhost
# Node.js doesn't use the system trust store: point it at the mkcert root CA so it
# accepts the local certificate. Set it in your shell, not here, e.g.
#   export NODE_EXTRA_CA_CERTS="$(mkcert -CAROOT)/rootCA.pem"
